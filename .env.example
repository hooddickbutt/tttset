# Public app URL used for payment links, sitemap, and metadata.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Robinhood Chain mainnet. Use 46630 and the testnet RPC for testnet.
# Documented at https://docs.robinhood.com/chain/connecting/
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Leave blank until a contract is deployed. Keel will not invent an address.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TOKEN_NAME=Keel
NEXT_PUBLIC_TOKEN_SYMBOL=KEEL

# Optional. Enables WalletConnect when set. Do not commit a real project id if it is private.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Prefer this for a provider key. Never prefix a secret with NEXT_PUBLIC_.
RPC_URL=
DATABASE_URL=file:./data/keel.db
SESSION_SECRET=
ADMIN_SECRET=

# Reserved. Historical indexing is not connected. Leave blank.
INDEXER_API_KEY=
API_KEY=

# Optional public contact shown in the footer.
CONTACT_EMAIL=
